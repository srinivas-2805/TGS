# ==============================================================================
# TELANGANA GRAMMAR SCHOOL (TGS) - ROOT ENVIRONMENT EXAMPLE
# Copy this file to .env and fill in secure values before running.
# ==============================================================================

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tgs_school
DB_USERNAME=tgs_admin
DB_PASSWORD=change_me_strong_db_password

# JWT Security (Minimum 32 characters / 256-bit base64 or hex secret)
JWT_SECRET=change_me_to_a_secure_random_256_bit_secret_key_for_tgs_portal
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Application URLs & CORS
APP_PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage Provider (LOCAL or S3)
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=10
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email Integration (SMTP - leave disabled if not configured)
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@tgs-kalluru.example.edu.in

# SMS Integration (DISABLED | LOG_ONLY | TWILIO | MSG91)
SMS_PROVIDER=LOG_ONLY
SMS_API_KEY=
SMS_SENDER_ID=TGSSCH
SMS_API_URL=

# Payment Gateway (CONFIGURABLE: MANUAL_ONLY | RAZORPAY)
PAYMENT_GATEWAY_PROVIDER=MANUAL_ONLY
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# School Defaults & Seeding
APP_SEED_DEMO_DATA=true
SCHOOL_LATE_FEE_PER_DAY=5

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_APP_NAME=Telangana Grammar School
